# When true, locks the UI language to English and hides the language switcher. Defaults to false.
VITE_NO_TRANSLATIONS=false

# the public site is fully static. Defaults to http://localhost:8001.
# Where the browser sends API calls.
#
# Leave EMPTY for same-origin: the app requests /api/... and whatever serves the
# site forwards it to the CMS — nginx in production, the vite dev server
# locally. Same-origin means no CORS and no cross-origin request to configure.
#
# Set this only when the API genuinely lives on another host, e.g.
# VITE_CMS_API_URL=https://cms.assistsec.nl
VITE_CMS_API_URL=
