# TanStack Router
.tanstack/
# `**/` matters: a pattern containing a slash is anchored to this file's
# directory, so a bare `src/routeTree.gen.ts` would only match at the repo root
# and miss the real file at frontend/src/routeTree.gen.ts.
**/src/routeTree.gen.ts

# Build output
dist/
dist-ssr/
*.local

# TypeScript
*.tsbuildinfo

# Framework / tooling caches
.turbo/
.eslintcache

