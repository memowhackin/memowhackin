# Configuration for `docker compose`. Copy to .env and fill in.
#
# This file is only read by docker compose — the apps themselves are configured
# through the environment variables compose passes them, never by reading a file
# baked into an image. For running the apps outside Docker, see
# frontend/example.env and backend/.env.example.

# Database. DB_PASSWORD has no default on purpose: compose refuses to start
# without it rather than bringing up a database with a guessable password.
DB_NAME=as_landing
DB_USER=landing
DB_PASSWORD=

# Port the site is published on.
SITE_PORT=8080

# Origins allowed to make credentialed requests to the API. Must match the
# address people actually use, or every login is rejected by the origin check.
# In production: https://assistsec.nl
ALLOWED_ORIGINS=http://localhost:8080

# Session cookies. "false" is only correct for a plain-HTTP deployment such as
# a local `docker compose up`; browsers reject Secure cookies over HTTP and the
# login would appear to work while never keeping you signed in.
# Set to "true" the moment this is served over HTTPS.
SECURE_COOKIES=false

# Optional. Publishing a post calls this to rebuild the statically hosted site.
# Leave empty and publishing still works; the rebuild is just manual.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
