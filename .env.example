# Configuration for `docker compose`. Copy to .env and fill in.
#
# This file is only read by docker compose — the apps themselves are configured
# through the environment variables compose passes them, never by reading a file
# baked into an image. For running the apps outside Docker, see
# frontend/.env.example and backend/.env.example.

# Database. DB_PASSWORD has no default on purpose: compose refuses to start
# without it rather than bringing up a database with a guessable password.
DB_NAME=as_landing
DB_USER=landing
DB_PASSWORD=

# Port the site is published on.
SITE_PORT=8080

# Origins allowed to make credentialed requests to the API. Must match the
# address people actually use, or every login is rejected by the origin check.
# In production: https://assistsec.nl
ALLOWED_ORIGINS=http://localhost:8080

# Session cookies. "false" is only correct for a plain-HTTP deployment such as
# a local `docker compose up`; browsers reject Secure cookies over HTTP and the
# login would appear to work while never keeping you signed in.
# Set to "true" the moment this is served over HTTPS.
SECURE_COOKIES=false

# Optional. Publishing a post calls this to rebuild the statically hosted site.
# Leave empty and publishing still works; the rebuild is just manual.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=

# --- Mail for the contact and demo forms ----------------------------------
# Optional, and losing nothing when unset: the backend stores every inquiry and
# answers the visitor either way, then logs that it could not mail and leaves
# delivered_at null so the row can be retried. Configuring this only decides
# whether a submission also reaches an inbox.
#
# Port 465 means implicit TLS; anything else upgrades with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Must be an address the SMTP account may send as — most providers reject a
# From that is not the authenticated mailbox, so this usually equals SMTP_USER.
SMTP_FROM=AssistSec <noreply@assistsec.nl>

# Where submissions land. The visitor goes in Reply-To, never in From: a message
# claiming to come from their domain is what SPF and DMARC exist to reject.
INQUIRY_RECIPIENT=contact@assistsec.nl

# --- Digital exposure scanner --------------------------------------------
# Off unless switched on. Leave SCANNER_ENABLED=false and the rest is ignored.
#
# Compose runs the backend with NODE_ENV=production, where SCANNER_PROVIDER
# `fixture` is refused outright — inventing findings about a real company is
# the worst thing this feature could do. Use `live`, or leave the scanner off.
SCANNER_ENABLED=false
SCANNER_PROVIDER=none

# `log` writes report mail to the process log and sends nothing. A real
# transport belongs in backend/src/scanner/mail.ts.
SCANNER_MAIL_TRANSPORT=none

# Both required when SCANNER_ENABLED=true. The key is 32 bytes of base64 and
# encrypts the subject address and findings at rest; losing it makes every
# stored scan unreadable, so it belongs in the backup set.
#   openssl rand -base64 32
SCANNER_ENCRYPTION_KEY=
SCANNER_PUBLIC_BASE_URL=

# Retention. Reports stop being readable after this many hours; a mailed
# single-use link expires after this many minutes.
SCANNER_REPORT_TTL_HOURS=72
SCANNER_TOKEN_TTL_MINUTES=30
