# Copy to .env and fill in. Every value is validated on boot by src/env.ts — the
# process refuses to start rather than run half-configured.
#
# The database is configured as separate fields rather than one URL because
# passwords commonly contain characters (#, ?, @, /) that silently break a
# connection string unless every one is percent-encoded.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=as_landing
DB_USER=admin
DB_PASSWORD=
# "true" for managed Postgres that requires TLS, "false" on a LAN or compose host.
DB_SSL=false

# Exact origins allowed to send credentialed requests. Comma-separated; a
# wildcard is not accepted and would be invalid with credentials anyway.
ALLOWED_ORIGINS=http://localhost:3000

PORT=8001

# Where processed images are written. These files are the only copy — this path
# belongs in the backup set.
UPLOAD_DIR=./uploads/blog

# Publishing asks the static site to rebuild through this hook. Leave both empty
# and publishing still works; the rebuild just stays manual.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=

NODE_ENV=development

# Marks session cookies Secure and gives them the __Host- prefix. Defaults to on
# in production. Set "false" only for a deployment you know is plain HTTP —
# browsers silently drop Secure cookies over HTTP, which looks like a login that
# succeeds and then immediately forgets you.
# SECURE_COOKIES=true

# --- Digital exposure scanner -------------------------------------------
# Off unless switched on. Every part of it (outbound requests to submitted
# hosts, stored personal exposure data, transactional mail) is a liability on a
# deployment that does not use the feature.
SCANNER_ENABLED=false

# Which scan backend answers. `fixture` returns canned results for local
# development and is REFUSED in production: a marketing site that invents
# security findings about a real visitor's domain is worse than no scanner.
# `none` leaves the feature off.
SCANNER_PROVIDER=none

# Transactional mail for report links. `log` writes to the process log and
# sends nothing. A real transport belongs in src/scanner/mail.ts.
SCANNER_MAIL_TRANSPORT=none

# Required when SCANNER_ENABLED=true. 32 bytes of base64; encrypts the subject
# address and the stored findings at rest.
#   openssl rand -base64 32
SCANNER_ENCRYPTION_KEY=

# Required when SCANNER_ENABLED=true. Absolute origin the single-use report
# links are built against, with no trailing path.
SCANNER_PUBLIC_BASE_URL=https://assistsec.nl

# Retention. A finished report stops being readable after this many hours.
SCANNER_REPORT_TTL_HOURS=72

# How long a mailed magic link stays usable, in minutes. Short on purpose.
SCANNER_TOKEN_TTL_MINUTES=30
