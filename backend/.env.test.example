# Copy to .env.test and fill in. This is the database the integration suite is
# allowed to destroy — it creates accounts, publishes posts and deletes rows.
#
# The name must end in _test, or the suite refuses to run rather than risk a
# database someone is using. Create it once:
#
#   createdb as_landing_test          # or: psql -c 'CREATE DATABASE as_landing_test'
#   DB_NAME=as_landing_test npm run db:migrate
DB_HOST=localhost
DB_PORT=5432
DB_NAME=as_landing_test
DB_USER=
DB_PASSWORD=
DB_SSL=false
ALLOWED_ORIGINS=http://localhost:3000
